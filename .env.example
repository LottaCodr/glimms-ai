# Runtime
LOG_LEVEL=INFO
# AWS / S3 (required for image-key endpoints)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=glimms-images
# Optional S3-compatible endpoint for MinIO/local development.
S3_ENDPOINT_URL=

# AI Providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307
DEFAULT_LLM_PROVIDER=openai
LLM_MAX_TOKENS=600
LLM_TIMEOUT_SECONDS=30

# Object detection
# Mount/download a domain-specific YOLOv8 ONNX model to enable real detections.
MODEL_PATH=models/yolov8n.onnx
MODEL_LABELS=
MODEL_INPUT_SIZE=640
CONFIDENCE_THRESHOLD=0.5
NMS_IOU_THRESHOLD=0.45

# Attribute extraction
# Disabled by default so local startup does not download a multi-hundred-MB model.
CLIP_ENABLED=false
CLIP_MODEL=openai/clip-vit-base-patch32
CLIP_LOCAL_ONLY=false

# Pinecone. If these are empty, embedding-engine uses a deterministic in-memory
# backend suitable for local development (not durable across restarts).
PINECONE_API_KEY=
PINECONE_INDEX=glimms-style
PINECONE_NAMESPACE=items

# Quality and permutation thresholds
BLUR_THRESHOLD=100
# Reserved for the optional BRISQUE/NIQE enhancement described in README.
BRISQUE_THRESHOLD=50
LOW_LIGHT_THRESHOLD=35
OVEREXPOSURE_THRESHOLD=245
MIN_IMAGE_DIMENSION=128
MAX_PERMUTATIONS=50
MAX_REASONING_DESIGNS=20
