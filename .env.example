# Runtime
LOG_LEVEL=INFO
# AWS / S3 (required for image-key endpoints)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=glimms-images
# Optional S3-compatible endpoint for MinIO/local development.
S3_ENDPOINT_URL=

# AI Providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307
DEFAULT_LLM_PROVIDER=openai
LLM_MAX_TOKENS=600
LLM_TIMEOUT_SECONDS=30

# Free fallback providers, tried only after OpenAI and Anthropic are
# unconfigured or fail. Pollinations (https://text.pollinations.ai/openai)
# needs no API key and is ALWAYS enabled, so a free fallback works with zero
# configuration. OpenRouter, Groq, Google AI Studio, NVIDIA NIM and GitHub
# Models are built in and activate automatically once their API key is set:
#   OPENROUTER_API_KEY=sk-or-...      # https://openrouter.ai/keys
#   GROQ_API_KEY=gsk_...              # https://console.groq.com/keys
#   GOOGLE_AI_API_KEY=AIza...         # https://aistudio.google.com/apikey (GEMINI_API_KEY also works)
#   NVIDIA_NIM_API_KEY=nvapi-...      # https://build.nvidia.com
#   GITHUB_MODELS_API_KEY=ghp_...     # https://github.com/settings/tokens (Models:read; GITHUB_TOKEN also works)
#
# Optional per-provider model overrides (defaults shown):
#   POLLINATIONS_MODEL=openai
#   OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
#   GROQ_MODEL=llama-3.3-70b-versatile
#   GOOGLE_AI_MODEL=gemini-2.5-flash
#   NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct
#   GITHUB_MODELS_MODEL=gpt-4.1
#
# To add further OpenAI-compatible providers, use comma-separated lists whose
# entries align by position (API keys may be empty for keyless providers):
#   FALLBACK_LLM_BASE_URL=https://example.com/v1,https://other.com/v1
#   FALLBACK_LLM_API_KEY=,sk-...
#   FALLBACK_LLM_MODEL=model-a,model-b
#
# Set FALLBACK_LLM_DISABLE=true to turn the whole free tier off.
OPENROUTER_API_KEY=
GROQ_API_KEY=
GOOGLE_AI_API_KEY=
NVIDIA_NIM_API_KEY=
GITHUB_MODELS_API_KEY=
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=
FALLBACK_LLM_DISABLE=false

# Object detection
# Mount/download a domain-specific YOLOv8 ONNX model to enable real detections.
MODEL_PATH=models/yolov8n.onnx
MODEL_LABELS=
MODEL_INPUT_SIZE=640
CONFIDENCE_THRESHOLD=0.5
NMS_IOU_THRESHOLD=0.45

# Attribute extraction
# Disabled by default so local startup does not download a multi-hundred-MB model.
CLIP_ENABLED=false
CLIP_MODEL=openai/clip-vit-base-patch32
CLIP_LOCAL_ONLY=false

# Pinecone. If these are empty, embedding-engine uses a deterministic in-memory
# backend suitable for local development (not durable across restarts).
PINECONE_API_KEY=
PINECONE_INDEX=glimms-style
PINECONE_NAMESPACE=items

# Quality and permutation thresholds
BLUR_THRESHOLD=100
# Reserved for the optional BRISQUE/NIQE enhancement described in README.
BRISQUE_THRESHOLD=50
LOW_LIGHT_THRESHOLD=35
OVEREXPOSURE_THRESHOLD=245
MIN_IMAGE_DIMENSION=128
MAX_PERMUTATIONS=50
MAX_REASONING_DESIGNS=20
